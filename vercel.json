{
  "headers": [
    {
      "source": "/api-ai/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate, proxy-revalidate" },
        { "key": "Pragma", "value": "no-cache" },
        { "key": "Expires", "value": "0" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api-ai",
      "destination": "https://aicommerce-ai-service-production.up.railway.app/"
    },
    {
      "source": "/api-ai/(.*)",
      "destination": "https://aicommerce-ai-service-production.up.railway.app/$1"
    },
    {
      "source": "/((?!api-ai).*)",
      "destination": "/index.html"
    }
  ]
}


